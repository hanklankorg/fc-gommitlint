# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
.vscode
.idea/
*.swp
*.swo
*~

# OS-specific
.DS_Store
Thumbs.db
/bin
/dist
/.test-vms/
.env
generated

# Test coverage files
coverage.txt
coverage.html
coverage*.out

.claude/

# Alpine build signing keys (generated by abuild-keygen)
.abuild-keys/

# Backup files
*.bak

# Debian build artifacts (generated by dpkg-buildpackage)
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/*.substvars
debian/gommitlint/

# CI-generated release files (temporary files for GoReleaser)
release-notes.md
changelog-content.md
