#: cmd/gommitlint/main.go:248
msgid ""
"Examples:\n"
"   # Validate the HEAD commit\n"
"   gommitlint validate\n"
"\n"
"   # Validate the last 5 commits\n"
"   gommitlint validate --count 5\n"
"\n"
"   # Validate every commit on a feature branch\n"
"   gommitlint validate --base-branch main\n"
"\n"
"   # Read a commit message from stdin (commit-msg hook)\n"
"   cat .git/COMMIT_EDITMSG | gommitlint validate --message-file -\n"
"\n"
"   # Machine-readable output for CI pipelines\n"
"   gommitlint validate --format json"
msgstr ""
"Examples:\n"
"   # Validera HEAD-incheckningen\n"
"   gommitlint validate\n"
"\n"
"   # Validera de senaste 5 incheckningarna\n"
"   gommitlint validate --count 5\n"
"\n"
"   # Validera alla incheckningar på en funktionsgren\n"
"   gommitlint validate --base-branch main\n"
"\n"
"   # Läs incheckningsmeddelande från stdin (commit-msg-krok)\n"
"   cat .git/COMMIT_EDITMSG | gommitlint validate --message-file -\n"
"\n"
"   # Maskinläsbar utdata för CI-pipelines\n"
"   gommitlint validate --format json"

