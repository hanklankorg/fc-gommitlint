#: cmd/gommitlint/help_printer.go:513
msgid ""
"gommitlint - git commit linter\n"
"\n"
"%s\n"
"  gommitlint validate [--format FORMAT] [--count N] [options]\n"
"\n"
"%s\n"
"  --format FORMAT       output format: %s\n"
"  --count N             validate last N commits\n"
"  --base-branch BRANCH  validate from branch to HEAD\n"
"  --log-level LEVEL     logging level: %s\n"
"\n"
"%s\n"
"  # Validate current commit\n"
"  $ gommitlint validate\n"
"  ✓ abc1234 feat: add new feature\n"
"  ✓ All checks passed\n"
"\n"
"  # Validate multiple commits\n"
"  $ gommitlint validate --count 3\n"
"  #1 ✓ abc1234 feat: add feature\n"
"  #2 ✓ def5678 fix: resolve bug\n"
"  #3 ✗ bad7890 bad commit message\n"
"  ✗ 1 issue found\n"
"\n"
"  # CI/CD automation with JSON output\n"
"  $ gommitlint validate --format json | jq '.summary.allPassed'\n"
"  true\n"
"\n"
"  # Validate feature branch commits\n"
"  $ gommitlint validate --base-branch main\n"
"  #1 ✓ abc1234 feat: new feature\n"
"  ✓ All checks passed\n"
"\n"
"%s\n"
"  validate    validate commit messages (primary command)\n"
"  doctor      inspect configuration, hooks, and effective policy\n"
"  config      configuration operations  \n"
"  hook        manage Git hooks\n"
"  --version   print version information\n"
"\n"
"Docs: https://docs.itiquette.org/gommitlint/\n"
"Issues: https://codefloe.com/itiquette/gommitlint/issues\n"
"Manual: man gommitlint\n"
"\n"
"Full options: gommitlint --help\n"
msgstr ""
"gommitlint - git-incheckningslinter\n"
"\n"
"%s\n"
"  gommitlint validate [--format FORMAT] [--count N] [options]\n"
"\n"
"%s\n"
"  --format FORMAT       utdataformat: %s\n"
"  --count N             validera de senaste N incheckningarna\n"
"  --base-branch BRANCH  validera från gren till HEAD\n"
"  --log-level LEVEL     loggnivå: %s\n"
"\n"
"%s\n"
"  # Validera aktuell incheckning\n"
"  $ gommitlint validate\n"
"  ✓ abc1234 feat: add new feature\n"
"  ✓ Alla kontroller godkända\n"
"\n"
"  # Validera flera incheckningar\n"
"  $ gommitlint validate --count 3\n"
"  #1 ✓ abc1234 feat: add feature\n"
"  #2 ✓ def5678 fix: resolve bug\n"
"  #3 ✗ bad7890 dåligt incheckningsmeddelande\n"
"  ✗ 1 problem hittat\n"
"\n"
"  # CI/CD-automation med JSON-utdata\n"
"  $ gommitlint validate --format json | jq '.summary.allPassed'\n"
"  true\n"
"\n"
"  # Validera incheckningar i funktionsgren\n"
"  $ gommitlint validate --base-branch main\n"
"  #1 ✓ abc1234 feat: new feature\n"
"  ✓ Alla kontroller godkända\n"
"\n"
"%s\n"
"  validate    validera incheckningsmeddelanden (huvudkommando)\n"
"  doctor      inspektera konfiguration, krokar och effektiv policy\n"
"  config      konfigurationsåtgärder  \n"
"  hook        hantera Git-krokar\n"
"  --version   skriv ut versionsinformation\n"
"\n"
"Dokumentation: https://docs.itiquette.org/gommitlint/\n"
"Problem: https://codefloe.com/itiquette/gommitlint/issues\n"
"Manual: man gommitlint\n"
"\n"
"Alla flaggor: gommitlint --help\n"

